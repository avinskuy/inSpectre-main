# Copy this file to .env and configure only the integrations you use.
# Never commit real credentials or share production API keys.

# Server
PORT=5000
HOST=127.0.0.1
TRUST_PROXY=0
CORS_ORIGIN=http://localhost:3000

# Persistent data paths
# INSPECTRE_DATA_DIR=
# INSPECTRE_DB_PATH=
# INSPECTRE_NUMBERS_FILE=

# Environmental intelligence
NASA_FIRMS_MAP_KEY=
OPENAQ_API_KEY=
# BMKG public data endpoints do not require an API key.

# Digital security
GOOGLE_SAFE_BROWSING_API_KEY=
# Optional Android AAPT executable used for APK manifest inspection.
# AAPT_PATH=/usr/bin/aapt

# Phone-number reputation provider (optional)
WHOTAGME_API_KEY=

# AI assistance (optional)
OPENROUTER_API_KEY=

# Optional pre-created demo account for jury access.
# Use a unique strong password and configure it only on the server.
DEMO_ACCOUNT_EMAIL=
DEMO_ACCOUNT_PASSWORD=
