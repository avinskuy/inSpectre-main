# ─── inSpectre — Konfigurasi Environment ───
# Salin file ini jadi .env lalu isi nilai aslinya:
#   cp .env.example .env

# Token bot dari @BotFather (opsional — tanpa ini API & dashboard tetap jalan, bot nonaktif)
# Cara dapat: chat @BotFather → /newbot → salin token

# Port server Express + Socket.IO (default 5000; frontend dev memakai port 3000)
PORT=5000

# Origin frontend yang diizinkan (default * untuk demo). Produksi: isi domain, pisahkan koma
# CORS_ORIGIN=https://inspectre.example.com

# Lokasi aapt untuk scan APK (opsional; otomatis dicari di ANDROID_HOME / /usr/bin)
# AAPT_PATH=/usr/bin/aapt

# Set TRUST_PROXY=1 only when backend is behind a trusted reverse proxy.
# TRUST_PROXY=1
